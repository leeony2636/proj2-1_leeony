# 실제 값은 .env에만 적으세요.
# 수정 사유: baseline은 오프라인 비교 전용이며 실제 Agent 실패를 조용히 대체하지 않는다.
# API 키를 준비하지 않은 로컬 환경에서는 Agent 요청이 안전한 ERROR로 끝난다.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Exact model slug required; deliberately no implicit/free fallback.
OPENROUTER_MODEL=
# 모든 OpenRouter 호출은 코드에서 ZDR + data_collection=deny를 강제한다.
# 공식 4모델 선정 기본 후보는 evals/model_candidates.example.json에 고정되어 있다.
# 필요할 때만 아래 값으로 4개 ID를 덮어쓴다. 비워두면 candidate JSON을 사용한다.
OPENROUTER_MODELS=
# ZDR endpoint 중 지나치게 비싼 provider로 라우팅되는 것을 막는 요청 단위 가격 상한($/1M tokens).
# 공식 model_selection runner가 policy 값(1.0 / 5.0)을 실행 중 강제한다.
OPENROUTER_MAX_PROMPT_PRICE_PER_M=1.00
OPENROUTER_MAX_COMPLETION_PRICE_PER_M=5.00
# 4모델 전체 선정 테스트의 최대 누적 비용은 $5. 전용 OpenRouter key에도 $5 이하 spending limit을 건다.
MODEL_SELECTION_BUDGET_USD=5.00
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=escape-room-agent
# Azure OpenAI 관련 값은 현재 OpenRouter 4모델 선정 테스트와 별개인 보존 설정입니다.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# P0 기본값은 memory입니다. PostgreSQL 전환 시 postgres로 변경하세요.
RUNTIME_REPOSITORY=memory
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app

# 참가자용 핵심 Tool의 MCP 호출 방식. Docker 서비스 분리 전 기본값은 local입니다.
MCP_CLIENT_TRANSPORT=local
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_CLIENT_TIMEOUT_SECONDS=10
MCP_SERVER_TRANSPORT=streamable-http
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
